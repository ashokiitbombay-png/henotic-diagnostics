# ===================================================================
# Henotic Diagnostics — Environment Variables
# Copy this to .env.local and fill in your credentials
# ===================================================================

# ===== Core Settings =====
# Next.js ISR (Incremental Static Regeneration) Revalidation Secret
# Used to securely trigger cache invalidation via API. Generate a random string.
REVALIDATION_SECRET=your-revalidation-secret
WEBHOOK_SIGNING_SECRET=your-webhook-hmac-signing-secret

# Payload CMS (optional — for dual-CMS webhook support)
PAYLOAD_WEBHOOK_SECRET=your-payload-cms-webhook-signing-secret
PAYLOAD_CMS_URL=https://payload.henoticdiagnostics.com

# ===== CMS (Content Management System) =====
# The URL to your WordPress GraphQL endpoint
# Used for fetching dynamic content (blogs, etc.)
WORDPRESS_API_URL=https://cms.henoticdiagnostics.com/graphql
NEXT_PUBLIC_WORDPRESS_API_URL=https://cms.henoticdiagnostics.com/graphql

# ===== Communication (Email & SMS & WhatsApp) =====
# Email (SMTP) Configuration
# For sending booking confirmation emails to admin and patients.
# If using Gmail, you MUST use App Passwords (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@henoticdiagnostics.com
ADMIN_EMAIL=admin@henoticdiagnostics.com

# Twilio SMS Configuration
# For sending patient booking confirmations via SMS.
# Get credentials from your Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1234567890

# WhatsApp Business API Configuration
# For automated WhatsApp booking confirmations.
# Setup via Meta for Developers: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_API_TOKEN=your-whatsapp-token

# ===== Monitoring & Analytics =====
# Sentry Error Tracking
# Reports frontend and backend errors. Get DSN from https://sentry.io -> Settings -> Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# Microsoft Clarity
# Used for session recordings and heatmaps. Get ID from https://clarity.microsoft.com -> Settings
NEXT_PUBLIC_CLARITY_ID=your-clarity-project-id

# Meta Pixel (Facebook Pixel)
# Used for retargeting and conversion tracking. Get ID from https://business.facebook.com -> Events Manager
NEXT_PUBLIC_FB_PIXEL_ID=your-fb-pixel-id

# Tawk.to Live Chat Widget
# Property ID for Tawk.to chat. Get from https://dashboard.tawk.to -> Administration
NEXT_PUBLIC_TAWKTO_ID=your-tawkto-property-id
NEXT_PUBLIC_TAWKTO_WIDGET_ID=1jsmtig1n

# Google Analytics 4
# Used for website traffic tracking. Get Measurement ID from https://analytics.google.com -> Admin -> Data Streams
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# ===== Payment =====
# Razorpay Payment Gateway
# For collecting advance payments for diagnostic bookings.
# Get keys from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ===== CRM Integration =====
# Customer Relationship Management Integration
# When configured, booking form will submit leads to your CRM endpoint.
CRM_API_URL=https://your-crm.com/api
CRM_API_KEY=your-crm-api-key
